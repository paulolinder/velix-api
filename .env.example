# ============================================================
# Velix API — Variáveis de Ambiente
# Copie para .env e preencha os valores.
# Nunca commite o arquivo .env!
# ============================================================

# Aplicação
APP_NAME=Velix API
APP_VERSION=1.0.0
APP_ENV=production          # development | staging | production
LOG_LEVEL=info              # debug | info | warn | error

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL
DATABASE_URL=postgres://velix:SENHA_DO_BANCO@postgres:5432/velix?sslmode=disable
DATABASE_MAX_OPEN_CONNS=100
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=5m

# Credenciais do Postgres (usadas pelo docker-compose.prod.yml)
POSTGRES_USER=velix
POSTGRES_PASSWORD=SENHA_DO_BANCO
POSTGRES_DB=velix

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Autenticação
# IMPORTANTE: mude para uma string aleatória de pelo menos 32 caracteres!
JWT_SECRET=mude-para-um-segredo-forte-de-no-minimo-32-chars
JWT_EXPIRY=24h
API_KEY_LENGTH=32

# Armazenamento de Mídia
MEDIA_STORAGE_PATH=/data/media
MEDIA_MAX_FILE_SIZE=67108864   # 64 MB em bytes

# Engine WhatsApp
ENGINE_STORE_PATH=/data/instances
ENGINE_AUTO_RECONNECT=true
ENGINE_QR_TIMEOUT=60s
ENGINE_MAX_INSTANCES=200

# CORS (origens permitidas, separadas por vírgula — use * apenas em dev)
CORS_ALLOWED_ORIGINS=*

# Versão da imagem Docker (usada pelo docker-compose.prod.yml)
VELIX_VERSION=latest
